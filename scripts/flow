#!/usr/bin/env bash
# flow —— collab-flow work-item 状态机引擎 CLI 入口(P2)。
#
# 极薄壳:只做顶层命令分发(workitem 子命令透传 core.py)与 --help,
# 参数解析/业务逻辑/--json 包装全部下沉 scripts/flow-core.py(审查补充意见 1)。
#
# 用法:
#   flow workitem new      <id> [--brief FILE] [--force] [--json]
#   flow workitem status   <id> [--json]
#   flow workitem transition <id> <to> [--event E] [--route design|impl] [--approve] [--guard-check] [--force] [--json]
#   flow workitem list     [--state S] [--json]
#   flow workitem log      <id> [--limit N] [--json]
#   flow workitem lock     <id> [--owner ID] [--ttl SECONDS] [--json]
#   flow workitem unlock   <id> [--owner ID] [--force] [--json]
#   flow workitem show     <id> <artifact>
#   flow workitem guard    <id> --gate quality|test [--json]
#   flow workitem verify   <id> [--tests b] [--diff b] [--errors b] [--route design|impl] [--json]
#   flow workitem design   <id> [--async [--expected N]] [--check] [--force] [--json]
#   flow workitem execute  <id> [--executor NAME] [--timeout N] [--force] [--json]
#   flow workitem decision <id> --verdict pass|reject|takeover [--defect-type T] [--summary S] [--json]
#   flow task add/status/list/log/run/reconcile(M1 后台任务队列,见 flow-task-core.py)
#
# 退出码: 0 成功 / 1 运行失败(守卫拒绝等) / 2 用法或前置错误 /
#         3 async 设计运行中(design --check) / 124 超时
#
# design --async:后台起 worker 立即返回(exit 0);--check 幂等查询,完成则落盘并转 designed
# (运行中 exit 3;超预期时长报警 alarm:"timeout" exit 124;失败 exit 1;已设计 no-op exit 0)。

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CORE="$SCRIPT_DIR/flow-core.py"
TASK_CORE="$SCRIPT_DIR/flow-task-core.py"

usage() {
  sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  "")        usage >&2; exit 2 ;;
  -h|--help) usage; exit 0 ;;
  workitem)
    shift
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    exec python3 "$CORE" workitem "$@"
    ;;
  task)
    shift
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    exec python3 "$TASK_CORE" task "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
